layout_mode = 2
text = "Attacker: None"

[node name="IntervenedFor" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Intervened for: None"

[node name="WoundType" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Wound type: None"

[node name="BlockAbility" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
